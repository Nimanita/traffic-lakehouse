{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "move_data_from_council_to_landing",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "get_last_ingested_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"additionalColumns": [
							{
								"name": "source",
								"value": "B"
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"modifiedDatetimeStart": {
								"value": "@activity('get_last_ingested_date').output.firstRow.cdc",
								"type": "Expression"
							},
							"modifiedDatetimeEnd": {
								"value": "@utcNow()",
								"type": "Expression"
							},
							"wildcardFolderPath": "raw_roads",
							"wildcardFileName": "*",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "PreserveHierarchy"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "council",
						"type": "DatasetReference",
						"parameters": {
							"folder": "raw_roads",
							"file": "*"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "landing",
						"type": "DatasetReference",
						"parameters": {
							"folder": "raw_roads2"
						}
					}
				]
			},
			{
				"name": "get_last_ingested_date",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "next_cdc",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "azuremetadata",
						"type": "DatasetReference",
						"parameters": {
							"file": "cdc.json"
						}
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "next_cdc",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "next_cdc",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "change_cdc_data",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "move_data_from_council_to_landing",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"additionalColumns": [
							{
								"name": "cdc",
								"value": {
									"value": "@variables('next_cdc')",
									"type": "Expression"
								}
							}
						],
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "MergeFiles"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "azuremetadata",
						"type": "DatasetReference",
						"parameters": {
							"file": "empty.json"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "azuremetadata",
						"type": "DatasetReference",
						"parameters": {
							"file": "cdc.json"
						}
					}
				]
			}
		],
		"parameters": {
			"folder": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
		"variables": {
			"next_cdc": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-07-28T03:49:56Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}